# Dashboard Frontend - Node.js Image
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY dashboard/web/package*.json ./

# Install dependencies
RUN npm install

# Copy web source
COPY dashboard/web/ ./

# Build frontend
RUN npm run build

# Expose Vite dev server port
EXPOSE 5174

# Start dev server
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]
